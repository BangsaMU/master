{
    "name": "bangsamu/master",
    "description": "Clay menggunakan master",
    "type": "library",
    "license": "MIT",
    "require": {
        "bangsamu/library-clay": "*",
        "maatwebsite/excel": "*",
        "jenssegers/agent": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bangsamu\\Master\\": "src/",
            "Bangsamu\\Master\\Database\\Seeds\\": "src/database/seeds/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bangsamu\\Master\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/stubs/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bangsamu\\Master\\MasterPackageServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "infomediaku.com",
            "email": "hatur.cms@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit"
    }
}
